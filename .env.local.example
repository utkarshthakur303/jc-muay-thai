# Copy to .env.local and fill in. See SETUP-AUTH.md for where each value lives.
# .env.local is git-ignored — never commit real keys.

# ---- Supabase (Project Settings -> API) ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Bypasses row-level security. Server-side only, never exposed to the browser.
SUPABASE_SECRET_KEY=sb_secret_...

# ---- Site ----
# Must match an entry in Supabase -> Authentication -> URL Configuration.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Email (Resend) — needed for the contact form and booking confirmations ----
# Auth emails are sent by Supabase via custom SMTP, configured in the dashboard.
RESEND_API_KEY=
# Verified sender for site email, e.g. noreply@jcmuaythai.com (Q1.9).
CONTACT_FROM_EMAIL=
# Where enquiry notifications are delivered (Q1.10).
CONTACT_NOTIFICATION_EMAIL=

# ---- Admin door (/admin/login) ----
# The ID typed at /admin/login. Optional — defaults to "admin" when unset.
# Not a secret: it is the guessable half of the credential, and the footer
# links the door from every page. The password does the work.
ADMIN_LOGIN_ID=admin
# The Supabase account that ID signs into. Required for /admin/login to work
# at all; unset, the page says so instead of failing at the auth call.
# The account must be confirmed AND present in the `admins` table.
# Its password is never stored here — Supabase holds it, and it is changed
# from /admin/security with email confirmation.
ADMIN_LOGIN_EMAIL=

# ---- Bot protection (optional, Cloudflare Turnstile) ----
# NOT IMPLEMENTED. No code reads these two and neither is in the Zod schema;
# the contact form's only bot mitigation today is its honeypot field. Left
# here as a placeholder for the work, not as configuration that does anything.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
